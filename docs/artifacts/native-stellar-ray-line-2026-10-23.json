    "path": "crates/render-wgpu/tests/ray_scene.rs::ray_shadow_bias_does_not_move_the_stellar_ray_sideways",
    "scene": "White receiver at z=-2, camera centre primary ray, diagonal stellar direction (1,0,1)/sqrt(2), disjoint 4mm quad centred at (0.99,0,-1), 1cm bias",
