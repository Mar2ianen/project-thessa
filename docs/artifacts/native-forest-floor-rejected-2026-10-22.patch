+                let mut sample = field.sample_surface(dir, (spacing * 2.0).max(32.0));
+                let cosine = dot(tile.normals[index].map(f64::from), dir).clamp(0.001, 1.0);
+                sample.slope_hint = (1.0 / (cosine * cosine) - 1.0).max(0.0).sqrt();
