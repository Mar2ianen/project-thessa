  "implementation": {
    "changed_path": "crates/render-wgpu/src/ray_query.wgsl::surface_visibility",
    "old": "Trace from position + geometric_normal * bias, t_min=bias; shifts the light line sideways",
    "new": "Trace from position on the physical stellar line, t_min=bias/dot(geometric_normal,stellar_direction); no query at nonpositive cosine or t_min >= t_max",
    "retained": [
      "shared primary and secondary visibility hook",
      "raster atlas and cloud visibility product",
      "RT disabled/shadow disabled fallback and no new allocation/pass",
      "existing settings, quality and RT distance/budget",
      "reflection-ray origin offsets",
      "plant geometry, placement, material reflectance and authoritative time"
    ],
    "limitation": "Finite receiver exclusion can still skip genuine nearby blockers; this is not a general ray-origin rounding-error solution, far-coordinate guarantee or coverage antialiasing"
  },
