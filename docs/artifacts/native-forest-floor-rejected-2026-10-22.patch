+/// Fine ground under a canopy is not the canopy's far-field green average.
+/// Authored optical priors only: there is no organic mass/growth inventory.
+/// `patch` is a filtered, world-fixed mixture coordinate, not a lighting term.
+fn canopy_floor(albedo: [f64; 3], canopy: f64, damp: f64, patch: f64, texel_m: f64) -> [f64; 3] {
+    // Resolve floor only below 1 m/texel; at >=2 m/texel the existing canopy
+    // proxy is exact. This is representation bandwidth, not a biome boundary.
+    let weight = canopy.clamp(0.0, 1.0) * band_weight(4.0, texel_m);
+    if weight == 0.0 {
+        return albedo;
+    }
+    let linear = |v: f64| {
+        if v <= 0.04045 {
+            v / 12.92
+        } else {
+            ((v + 0.055) / 1.055).powf(2.4)
+        }
+    };
+    let encode = |v: f64| {
+        if v <= 0.0031308 {
+            v * 12.92
+        } else {
+            1.055 * v.powf(1.0 / 2.4) - 0.055
+        }
+    };
+    let litter = [0.36, 0.26, 0.14].map(linear);
+    let live_ground = [0.16, 0.27, 0.11].map(linear);
+    let floor = mix(litter, live_ground, patch.clamp(0.0, 1.0));
+    let wetting = 1.0 - 0.25 * damp.clamp(0.0, 1.0);
+    // Reflectances mix in linear light, not in encoded display RGB. Wetting
+    // changes the material, never an ambient/shadow multiplier baked into it.
+    std::array::from_fn(|i| {
+        encode(linear(albedo[i]) * (1.0 - weight) + floor[i] * wetting * weight)
+    })
+}
